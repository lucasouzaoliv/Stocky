# Valores FALSOS. Copie para .env.local e preencha com os reais (nunca commite).
# Firebase (conta de serviço)
FIREBASE_PROJECT_ID=troque-aqui
FIREBASE_CLIENT_EMAIL=troque-aqui@exemplo.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=troque-aqui

# Discord OAuth2
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=troque-aqui
DISCORD_GUILD_ID=000000000000000000
# Listas separadas por vírgula
DISCORD_ROLE_MEMBRO=000000000000000000
DISCORD_ROLE_GERENTE=000000000000000000
DISCORD_ROLE_DONO=000000000000000000

# Sessão e URL
SESSION_SECRET=troque-aqui
APP_URL=http://localhost:3000

# Webhooks de aviso
WEBHOOK_LOG_MEMBROS=https://discord.com/api/webhooks/000000000000000000/troque-aqui
WEBHOOK_LOG_GERENCIA=https://discord.com/api/webhooks/000000000000000000/troque-aqui
WEBHOOK_LOG_CAIXA=https://discord.com/api/webhooks/000000000000000000/troque-aqui
